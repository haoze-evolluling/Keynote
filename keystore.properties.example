# Keynote Android Release Signing Configuration Template
# Copy this file to "keystore.properties" and fill in your actual credentials.
# NOTE: Never commit "keystore.properties" or the *.jks/*.keystore file to version control.

# Path to the release keystore file, relative to project root or absolute path
storeFile=Keynote-keystore/keynote-release.jks

# Keystore password
storePassword=your_keystore_password_here

# Key alias
keyAlias=keynote-release

# Key password
keyPassword=your_key_password_here
